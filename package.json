{
    "$schema": "https://www.schemastore.org/package.json",
    "private": true,
    "type": "module",
    "scripts": {
        "dev": "vite",
        "build": "vite build",
        "typecheck": "tsc --noEmit",
        "lint": "oxlint",
        "lint:fix": "oxlint --fix",
        "format": "oxfmt",
        "format:check": "oxfmt --check",
        "types:generate": "php artisan typescript:transform && php artisan wayfinder:generate",
        "check": "pnpm typecheck && pnpm lint",
        "e2e:server": "pnpm build && node scripts/e2e-server.mjs",
        "e2e:browser": "node scripts/e2e-browser.mjs"
    },
    "dependencies": {
        "@inertiajs/react": "^3.7.1",
        "axios": "^1.20.0",
        "clsx": "^2.1.1",
        "daisyui": "^5.7.46",
        "lucide-react": "^1.48.0",
        "react": "^19.3.0",
        "react-dom": "^19.3.0",
        "zod": "^4.6.5"
    },
    "devDependencies": {
        "@inertiajs/core": "^3.7.1",
        "@laravel/vite-plugin-wayfinder": "^0.1.10",
        "@tailwindcss/vite": "^4.0.0",
        "@types/node": "^26.6.3",
        "@types/react": "^19.3.0",
        "@types/react-dom": "^19.3.0",
        "@vitejs/plugin-react": "^6.1.1",
        "concurrently": "^10.0.3",
        "laravel-vite-plugin": "^3.1",
        "oxfmt": "^0.71.0",
        "oxlint": "^1.86.0",
        "tailwindcss": "^4.0.0",
        "typescript": "^7.0.2",
        "vite": "^8.0.0"
    },
    "engines": {
        "node": ">=22",
        "npm": "please-use-pnpm",
        "pnpm": ">=10",
        "yarn": "please-use-pnpm"
    },
    "packageManager": "pnpm@12.3.4"
}
