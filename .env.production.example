# Plantilla para produccion en servidores de bajos recursos (512MB-1GB RAM). Copiar como .env en el servidor.
APP_NAME="Mi App"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://midominio.com
APP_TIMEZONE=America/Lima
APP_LOCALE=es
ALLOW_REGISTRATION=false

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_LEVEL=warning
LOG_DAILY_DAYS=7

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=app
DB_USERNAME=app
DB_PASSWORD=

# Redis con extension phpredis (mas rapido y menos RAM que predis)
REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_SECURE_COOKIE=true
CACHE_STORE=redis
QUEUE_CONNECTION=redis

# Sin Redis? usa: SESSION_DRIVER=file  CACHE_STORE=file  QUEUE_CONNECTION=database (ver docs/DEPLOY.md)

BCRYPT_ROUNDS=12
MAIL_MAILER=smtp
MAIL_FROM_ADDRESS="no-reply@midominio.com"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"
